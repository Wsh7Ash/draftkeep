{
  "manifest_version": 3,
  "name": "draftkeep",
  "version": "0.1.0",
  "description": "Rescues text you typed into a form when the tab is closed or navigated away.",
  "permissions": ["storage", "activeTab"],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "draftkeep",
    "default_popup": "src/popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/content/collector.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
